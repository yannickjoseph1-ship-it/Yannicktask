# Variables de la stack bêta (docker-compose.beta.yml)
POSTGRES_USER=aquapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aquapp
JWT_SECRET=change-me-long-random-string
JWT_EXPIRES_IN=7d
# URL publique du front (redirections Stripe, CORS)
CLIENT_URL=http://localhost:8080
WEB_PORT=8080
# Stripe : vide = abonnement simulé impossible en production, les magasins ne pourront pas s'abonner
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PREMIUM=
